@startuml C2S_System_ERD

' C2S System - Complete Entity Relationship Diagram

!define TABLE(x) class x << (T,#FFAAAA) >>
!define PK(x) <u>x</u>
!define FK(x) <i>x</i>

hide methods
hide stereotypes

' ============ ENTITIES ============

TABLE(USER) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  email: VARCHAR(255) UNIQUE
  password: VARCHAR(255)
  role: ENUM
  avatar: VARCHAR(10)
  FK(group_id): VARCHAR(50)
  FK(cluster_id): VARCHAR(50)
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

TABLE(C2S_GROUP) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  description: TEXT
  age_group: ENUM
  location: VARCHAR(255)
  barangay: VARCHAR(255)
  schedule: VARCHAR(255)
  status: ENUM
  type: ENUM
  capacity: INT
  members_count: INT
  latitude: DECIMAL(10,8)
  longitude: DECIMAL(11,8)
  FK(leader_id): VARCHAR(50)
  FK(cluster_id): VARCHAR(50)
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

TABLE(MENTEE) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  email: VARCHAR(255)
  phone: VARCHAR(50)
  age: INT
  gender: ENUM
  birthday: DATE
  current_module: VARCHAR(255)
  current_lesson: VARCHAR(255)
  progress: INT
  status: ENUM
  FK(assigned_group_id): VARCHAR(50)
  FK(mentor_id): VARCHAR(50)
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

TABLE(POTENTIAL_MENTEE) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  email: VARCHAR(255)
  phone: VARCHAR(50)
  barangay: VARCHAR(255)
  status: ENUM
  cluster_status: ENUM
  date_submitted: DATE
  FK(assigned_coordinator_id): VARCHAR(50)
  FK(assigned_mentor_id): VARCHAR(50)
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

TABLE(CLUSTER) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  description: TEXT
  FK(cluster_head_id): VARCHAR(50)
  FK(coordinator_id): VARCHAR(50)
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

TABLE(BARANGAY) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  city: VARCHAR(100)
  FK(cluster_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(SUBDIVISION) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  FK(barangay_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(MODULE) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  description: TEXT
  sequence_order: INT
  created_at: TIMESTAMP
}

TABLE(LESSON) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  sequence_order: INT
  FK(module_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(MENTEE_PROGRESS) {
  PK(id): VARCHAR(50)
  FK(mentee_id): VARCHAR(50)
  FK(lesson_id): VARCHAR(50)
  completion_date: DATE
  status: ENUM
  notes: TEXT
  created_at: TIMESTAMP
}

TABLE(TRAINING) {
  PK(id): VARCHAR(50)
  label: VARCHAR(255)
  description: TEXT
  sequence_order: INT
  created_at: TIMESTAMP
}

TABLE(MENTEE_TRAINING) {
  PK(id): VARCHAR(50)
  FK(mentee_id): VARCHAR(50)
  FK(training_id): VARCHAR(50)
  year_completed: VARCHAR(10)
  status: ENUM
  created_at: TIMESTAMP
}

TABLE(GROUP_TAG) {
  PK(id): VARCHAR(50)
  label: VARCHAR(255)
  color: VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(GROUP_TAG_MAPPING) {
  FK(group_id): VARCHAR(50)
  FK(tag_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(ENDORSED_GROUP) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  members_count: INT
  progress: INT
  FK(endorsed_by_id): VARCHAR(50)
  FK(cluster_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(ENDORSED_WORKER) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  email: VARCHAR(255)
  progress: INT
  FK(assigned_group_id): VARCHAR(50)
  FK(endorsed_by_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(INACTIVE_MENTEE) {
  PK(id): VARCHAR(50)
  name: VARCHAR(255)
  date_inactive: DATE
  last_module: VARCHAR(255)
  reason: ENUM
  FK(assigned_group_id): VARCHAR(50)
  created_at: TIMESTAMP
}

TABLE(ACTIVITY_LOG) {
  PK(id): VARCHAR(50)
  text: TEXT
  timestamp: DATETIME
  read: BOOLEAN
  type: ENUM
  FK(user_id): VARCHAR(50)
  FK(related_mentee_id): VARCHAR(50)
  created_at: TIMESTAMP
}

' ============ RELATIONSHIPS ============

' User relationships
USER "1" -- "0..*" C2S_GROUP : "leads >"
USER "1" -- "0..*" MENTEE : "mentors >"
USER "1" -- "0..*" POTENTIAL_MENTEE : "coordinates >"
USER "1" -- "0..*" CLUSTER : "heads >"
USER "1" -- "0..*" ENDORSED_WORKER : "endorses >"
USER "1" -- "0..*" ACTIVITY_LOG : "performs >"

' C2S Group relationships
C2S_GROUP "1" -- "0..*" MENTEE : "has >"
C2S_GROUP "1" -- "0..*" INACTIVE_MENTEE : "had >"
C2S_GROUP "0..*" -- "0..*" GROUP_TAG : "tagged with"
(C2S_GROUP, GROUP_TAG) .. GROUP_TAG_MAPPING
C2S_GROUP "0..*" -- "1" CLUSTER : "< belongs to"

' Mentee relationships
MENTEE "1" -- "0..*" MENTEE_PROGRESS : "tracks >"
MENTEE "0..*" -- "0..*" TRAINING : "completes"
(MENTEE, TRAINING) .. MENTEE_TRAINING

' Cluster relationships
CLUSTER "1" -- "0..*" BARANGAY : "covers >"
CLUSTER "1" -- "0..*" ENDORSED_GROUP : "has >"

' Barangay relationships
BARANGAY "1" -- "0..*" SUBDIVISION : "contains >"

' Module/Lesson relationships
MODULE "1" -- "0..*" LESSON : "contains >"
LESSON "1" -- "0..*" MENTEE_PROGRESS : "tracked in >"

' Endorsed relationships
ENDORSED_GROUP "1" -- "0..*" ENDORSED_WORKER : "has >"

@enduml
