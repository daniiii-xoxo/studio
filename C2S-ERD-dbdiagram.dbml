// C2S System - Complete Entity Relationship Diagram
// Created for: COG Dasmariñas C2S App
// Database: MySQL/PostgreSQL
// Total Tables: 18

// ============================================
// AUTHENTICATION & USER MANAGEMENT
// ============================================

Table user {
  id varchar(50) [pk]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  role varchar(50) [not null, note: 'ministry_head, mentor, cluster_head, c2s_coordinator']
  avatar varchar(10)
  group_id varchar(50)
  cluster_id varchar(50)
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    email
    role
  }
  
  Note: 'User accounts with role-based access control'
}

// ============================================
// C2S GROUPS & GROUP MANAGEMENT
// ============================================

Table c2s_group {
  id varchar(50) [pk]
  name varchar(255) [not null]
  description text
  age_group varchar(50) [note: 'All, Teens, College Students, Young Adults, Adults']
  age_range varchar(50)
  location varchar(255)
  barangay varchar(255)
  schedule varchar(255)
  meetup_day varchar(50)
  status varchar(20) [default: 'Open', note: 'Open, Closed, Full']
  type varchar(30) [note: 'Community-based, Church-based']
  capacity int [default: 10]
  members_count int [default: 0]
  available_slots int [default: 10]
  latitude decimal(10,8)
  longitude decimal(11,8)
  is_featured boolean [default: false]
  leader_id varchar(50) [ref: > user.id]
  cluster_id varchar(50) [ref: > cluster.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    leader_id
    cluster_id
    barangay
    status
    (latitude, longitude)
  }
  
  Note: 'Discipleship groups (C2S connect groups)'
}

Table group_tag {
  id varchar(50) [pk]
  label varchar(255) [not null]
  color varchar(50)
  created_at timestamp [default: `now()`]
  
  Note: 'Tags for categorizing groups (Young Adults, Couples, etc.)'
}

Table group_tag_mapping {
  group_id varchar(50) [ref: > c2s_group.id]
  tag_id varchar(50) [ref: > group_tag.id]
  created_at timestamp [default: `now()`]
  
  indexes {
    (group_id, tag_id) [pk]
  }
  
  Note: 'Many-to-many relationship between groups and tags'
}

// ============================================
// MENTEES (ACTIVE PARTICIPANTS)
// ============================================

Table mentee {
  id varchar(50) [pk]
  name varchar(255) [not null]
  initials varchar(10)
  email varchar(255)
  phone varchar(50)
  age int
  gender varchar(10) [note: 'Male, Female']
  birthday date
  facebook varchar(255)
  first_attended date
  connected_since varchar(50)
  current_module varchar(255)
  current_lesson varchar(255)
  progress int [default: 0, note: '0-100 percentage']
  mentor_notes text
  status varchar(30) [default: 'Active', note: 'Active, Pending Review, Inactive']
  assigned_group_id varchar(50) [ref: > c2s_group.id]
  mentor_id varchar(50) [ref: > user.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    assigned_group_id
    mentor_id
    status
    email
  }
  
  Note: 'Active mentees in discipleship program'
}

Table inactive_mentee {
  id varchar(50) [pk]
  name varchar(255) [not null]
  date_inactive date
  last_module varchar(255)
  reason varchar(30) [note: 'Completed, Inactive, Transferred']
  assigned_group_id varchar(50) [ref: > c2s_group.id]
  created_at timestamp [default: `now()`]
  
  Note: 'Historical record of mentees who left or completed'
}

// ============================================
// POTENTIAL MENTEES (INCOMING REQUESTS)
// ============================================

Table potential_mentee {
  id varchar(50) [pk]
  name varchar(255) [not null]
  initials varchar(10)
  email varchar(255)
  phone varchar(50)
  age int
  gender varchar(10) [note: 'Male, Female']
  birthday date
  facebook varchar(255)
  first_attended date
  source varchar(50) [note: 'From C2S Group Finder, Recommended']
  requested_group varchar(255)
  preferred_groups json [note: 'Array of up to 2 preferred groups']
  group_type varchar(30) [note: 'Community-based, Church-based']
  barangay varchar(255)
  notes text
  status varchar(30) [default: 'Pending', note: 'Pending, Accepted, Recommended']
  cluster_status varchar(50) [note: 'New, Waiting for Assignment, Assigned to Mentor, Interview Scheduled, Interview Completed, Accepted']
  date_submitted date
  interview_date date
  progress int [default: 0]
  current_module varchar(255)
  current_lesson varchar(255)
  assigned_coordinator_id varchar(50) [ref: > user.id]
  assigned_mentor_id varchar(50) [ref: > user.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    assigned_coordinator_id
    assigned_mentor_id
    status
    cluster_status
    barangay
  }
  
  Note: 'People interested in joining C2S groups'
}

// ============================================
// ORGANIZATIONAL STRUCTURE
// ============================================

Table cluster {
  id varchar(50) [pk]
  name varchar(255) [not null]
  description text
  cluster_head_id varchar(50) [ref: > user.id]
  coordinator_id varchar(50) [ref: > user.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Geographic/organizational clusters of groups'
}

Table barangay {
  id varchar(50) [pk]
  name varchar(255) [not null]
  city varchar(100) [default: 'Dasmariñas']
  cluster_id varchar(50) [ref: > cluster.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    name
    cluster_id
  }
  
  Note: 'Geographic locations (barangays in Dasmariñas City)'
}

Table subdivision {
  id varchar(50) [pk]
  name varchar(255) [not null]
  barangay_id varchar(50) [ref: > barangay.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    barangay_id
  }
  
  Note: 'Subdivisions/villages within barangays'
}

// ============================================
// CURRICULUM & PROGRESS TRACKING
// ============================================

Table module {
  id varchar(50) [pk]
  name varchar(255) [not null]
  description text
  sequence_order int
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Discipleship curriculum modules (Module 1: Foundations, etc.)'
}

Table lesson {
  id varchar(50) [pk]
  name varchar(255) [not null]
  description text
  sequence_order int
  module_id varchar(50) [ref: > module.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    module_id
  }
  
  Note: 'Individual lessons within modules'
}

Table mentee_progress {
  id varchar(50) [pk]
  mentee_id varchar(50) [ref: > mentee.id]
  lesson_id varchar(50) [ref: > lesson.id]
  completion_date date
  status varchar(30) [note: 'Not Started, In Progress, Completed, Pending Review']
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    mentee_id
    lesson_id
    status
  }
  
  Note: 'Detailed tracking of lesson completion'
}

// ============================================
// TRAINING PROGRAMS
// ============================================

Table training {
  id varchar(50) [pk]
  label varchar(255) [not null]
  description text
  sequence_order int
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Training programs: CLDP 1-3, LIFE Movers, LAMP, etc.'
}

Table mentee_training {
  id varchar(50) [pk]
  mentee_id varchar(50) [ref: > mentee.id]
  training_id varchar(50) [ref: > training.id]
  year_completed varchar(10) [note: 'Year or dash (—) if not completed']
  status varchar(30) [note: 'Completed, In Progress, Not Started']
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  indexes {
    mentee_id
    training_id
  }
  
  Note: 'Training completion records for mentees'
}

// ============================================
// ENDORSEMENT & LEADERSHIP PIPELINE
// ============================================

Table endorsed_group {
  id varchar(50) [pk]
  name varchar(255) [not null]
  members_count int [default: 0]
  progress int [default: 0]
  endorsed_by_id varchar(50) [ref: > user.id]
  cluster_id varchar(50) [ref: > cluster.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Groups formed and led by endorsed workers'
}

Table endorsed_worker {
  id varchar(50) [pk]
  name varchar(255) [not null]
  initials varchar(10)
  endorsed_since varchar(50)
  email varchar(255)
  phone varchar(50)
  age int
  gender varchar(10)
  birthday date
  facebook varchar(255)
  first_attended date
  connected_since varchar(50)
  current_module varchar(255)
  current_lesson varchar(255)
  progress int [default: 0]
  mentor_notes text
  assigned_group_id varchar(50) [ref: > endorsed_group.id]
  endorsed_by_id varchar(50) [ref: > user.id]
  created_at timestamp [default: `now()`]
  updated_at timestamp
  
  Note: 'Mentees who have been endorsed to leadership positions'
}

// ============================================
// SYSTEM NOTIFICATIONS & ACTIVITY LOG
// ============================================

Table activity_log {
  id varchar(50) [pk]
  text text [not null]
  timestamp datetime
  read boolean [default: false]
  type varchar(50) [note: 'new_potential, assignment, interview, new_mentee, accepted, reassign, capacity']
  user_id varchar(50) [ref: > user.id]
  related_mentee_id varchar(50)
  created_at timestamp [default: `now()`]
  
  indexes {
    user_id
    timestamp
    type
    read
  }
  
  Note: 'System-wide activity log and notifications'
}

// ============================================
// RELATIONSHIP NOTES
// ============================================

// USER relationships:
// - leads C2S_GROUP (as mentor/leader)
// - mentors MENTEE
// - coordinates POTENTIAL_MENTEE (as coordinator)
// - heads CLUSTER (as cluster head)
// - endorses ENDORSED_WORKER

// C2S_GROUP relationships:
// - has many MENTEE
// - had many INACTIVE_MENTEE (history)
// - belongs to CLUSTER
// - tagged with GROUP_TAG (many-to-many)

// MENTEE relationships:
// - belongs to C2S_GROUP
// - mentored by USER
// - tracks MENTEE_PROGRESS
// - completes TRAINING (via MENTEE_TRAINING)

// CLUSTER relationships:
// - contains C2S_GROUP
// - covers BARANGAY
// - has ENDORSED_GROUP

// CURRICULUM flow:
// MODULE → LESSON → MENTEE_PROGRESS

// Geographic hierarchy:
// CLUSTER → BARANGAY → SUBDIVISION

// ============================================
// COMPLETE ENTITY CHECKLIST (18 TABLES)
// ============================================

// ✓ 1.  user - Authentication & roles
// ✓ 2.  c2s_group - Discipleship groups
// ✓ 3.  group_tag - Group categorization tags
// ✓ 4.  group_tag_mapping - Many-to-many junction table
// ✓ 5.  mentee - Active participants
// ✓ 6.  inactive_mentee - Historical records
// ✓ 7.  potential_mentee - Incoming requests
// ✓ 8.  cluster - Organizational structure
// ✓ 9.  barangay - Geographic locations
// ✓ 10. subdivision - Villages/subdivisions
// ✓ 11. module - Curriculum modules
// ✓ 12. lesson - Individual lessons
// ✓ 13. mentee_progress - Lesson completion tracking
// ✓ 14. training - Training programs (CLDP, LIFE, etc.)
// ✓ 15. mentee_training - Training completion records
// ✓ 16. endorsed_group - Groups led by endorsed workers
// ✓ 17. endorsed_worker - Leadership pipeline
// ✓ 18. activity_log - System notifications

// ============================================
// ALL RELATIONSHIPS DEFINED
// ============================================

// One-to-Many (1:∞):
// • user → c2s_group (leader_id)
// • user → mentee (mentor_id)
// • user → potential_mentee (assigned_coordinator_id, assigned_mentor_id)
// • user → cluster (cluster_head_id, coordinator_id)
// • user → endorsed_worker (endorsed_by_id)
// • user → endorsed_group (endorsed_by_id)
// • user → activity_log (user_id)
// • c2s_group → mentee (assigned_group_id)
// • c2s_group → inactive_mentee (assigned_group_id)
// • cluster → c2s_group (cluster_id)
// • cluster → barangay (cluster_id)
// • cluster → endorsed_group (cluster_id)
// • barangay → subdivision (barangay_id)
// • module → lesson (module_id)
// • lesson → mentee_progress (lesson_id)
// • mentee → mentee_progress (mentee_id)
// • mentee → mentee_training (mentee_id)
// • training → mentee_training (training_id)
// • endorsed_group → endorsed_worker (assigned_group_id)

// Many-to-Many (∞:∞):
// • c2s_group ↔ group_tag (via group_tag_mapping)
// • mentee ↔ training (via mentee_training)

